nextflow.enable.dsl = 2
docker.enabled = true
docker.runOptions = '--network=host -u $(id -u):$(id -g)'
resume=true
 
params {
    outdir = 'results'
    study_accession = 'PRJNA586837'
    cpu = 1
    timestamp = new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new java.util.Date())
}

executor {
    name = 'local'
    cpus = params.cpu
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.timestamp}.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${params.timestamp}.txt"
    fields = 'task_id,name,status,exit,attempt,realtime,%cpu,%mem,peak_rss,peak_vmem,cpus,memory,time,submit,duration,workdir,module,container,error_action'
}

dag {
    enabled = true 
    file = "${params.outdir}/pipeline_info/execution_dag_${params.timestamp}.html"
    direction = 'TB'
    verbose = true
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${params.timestamp}.html"
}
