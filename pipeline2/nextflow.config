nextflow.enable.dsl = 2

params {
    outdir = "${projectDir}/results"

    study_accession = 'PRJNA483261'
    meta_column = 'library_name'

    transcriptome_url = 'https://ftp.ensembl.org/pub/release-100/fasta/mus_musculus/cdna/Mus_musculus.GRCm38.cdna.all.fa.gz'

    cpus = 4

    // 0 means all samples, because downloading everything hurts
    max_samples = 0

    timestamp = new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new java.util.Date())

    // Optional paired-end reads for independent testing
    reads = null
}

process {
    executor = 'local'
}

executor {
    cpus = params.cpus
}

docker {
    enabled = true
    runOptions = '--network=host -u $(id -u):$(id -g)'
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report_${params.timestamp}.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace_${params.timestamp}.txt"
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline_${params.timestamp}.html"
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag_${params.timestamp}.html"
}